#!/bin/sh

# Small VirtualBox manager for the 42 RainFall appliance.
# It intentionally runs without sudo and stores the appliance outside Git.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)

VM_NAME=${RAINFALL_VM_NAME:-RainFall}
STORAGE_ROOT=${RAINFALL_STORAGE_ROOT:-"/sgoinfre/goinfre/Perso/$(id -un)"}
OVA_PATH=${RAINFALL_OVA_PATH:-"$STORAGE_ROOT/.tmp/rainfall-vm/RainFall_v2.ova"}
VM_BASE=${RAINFALL_VM_BASE:-"$STORAGE_ROOT/.home/.VMs"}
HOST_IP=${RAINFALL_HOST_IP:-127.0.0.1}
HOST_PORT=${RAINFALL_HOST_PORT:-4243}
GUEST_PORT=${RAINFALL_GUEST_PORT:-4242}
SSH_USER=${RAINFALL_SSH_USER:-level00}
PF_NAME=${RAINFALL_PF_NAME:-rainfall-ssh}
SHARED_DIR=${RAINFALL_SHARED_DIR:-"$REPO_ROOT/shared"}
SHARED_MOUNT=${RAINFALL_SHARED_MOUNT:-"/tmp/$(id -un)-rainfall-shared"}
SSHFS_BIN=${RAINFALL_SSHFS_BIN:-"$STORAGE_ROOT/.home/.Apps/bin/sshfs"}
OVA_URL_FILE=${RAINFALL_OVA_URL_FILE:-"$REPO_ROOT/assets/rainfall-ova-url.txt"}
DEFAULT_OVA_URL=https://cdn.intra.42.fr/isos/RainFall_v2.ova

if [ -s "$OVA_URL_FILE" ]; then
    OVA_URL=$(sed -n '1p' "$OVA_URL_FILE")
else
    OVA_URL=$DEFAULT_OVA_URL
fi

usage()
{
    cat <<EOF
Usage: $(basename "$0") <command> [arguments]

Commands:
  doctor              Check VirtualBox, SSH and local configuration
  download [path]     Download the official OVA outside the repository
  import [path]       Import the OVA as "$VM_NAME"
  setup [path]        Download if needed, import and configure SSH
  start               Start the VM in headless mode
  gui                 Start or show the VM with the VirtualBox GUI
  stop                Request a clean ACPI shutdown
  restart             Cleanly stop, wait, then start headless
  poweroff --force    Immediately power off the VM
  status              Show VM and SSH status
  ssh [level] [cmd]   Choose a level and connect using the preceding flag
  ssh --level N [cmd]  Same, with an explicit level (for example: 01)
  mount               Mount the VM's ~/shared directory into ./shared
  umount              Unmount the shared directory
  snapshot [name]     Take a VirtualBox snapshot
  info                Show complete VirtualBox information
  help                Show this help

Environment overrides:
  RAINFALL_VM_NAME, RAINFALL_OVA_PATH, RAINFALL_HOST_IP,
  RAINFALL_VM_BASE, RAINFALL_HOST_PORT, RAINFALL_GUEST_PORT,
  RAINFALL_SSH_USER, RAINFALL_SHARED_DIR, RAINFALL_SHARED_MOUNT,
  RAINFALL_SSHFS_BIN, RAINFALL_OVA_URL_FILE

No command requires sudo. The default login is level00 / level00.
EOF
}

die()
{
    printf 'error: %s\n' "$*" >&2
    exit 1
}

need()
{
    command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

normalise_level()
{
    raw_level=${1#level}
    case "$raw_level" in
        ''|*[!0-9]*)
            return 1
            ;;
    esac

    # Remove leading zeroes before using the value in shell arithmetic.
    level_number=$(printf '%s\n' "$raw_level" | sed 's/^0*//')
    [ -n "$level_number" ] || level_number=0
    [ "$level_number" -le 99 ] || return 1
    printf 'level%02d\n' "$level_number"
}

level_password()
{
    level_user=$1
    level_number=${level_user#level}
    level_number=$(printf '%s\n' "$level_number" | sed 's/^0*//')
    [ -n "$level_number" ] || level_number=0

    if [ "$level_number" -eq 0 ]; then
        printf '%s' level00
        return 0
    fi

    previous_number=$((level_number - 1))
    previous_level=$(printf 'level%02d' "$previous_number")
    flag_path=$REPO_ROOT/$previous_level/flag
    [ -f "$flag_path" ] || \
        die "missing credential for $level_user: $previous_level/flag"
    [ -s "$flag_path" ] || \
        die "empty credential for $level_user: $previous_level/flag"
    tr -d '\r\n' < "$flag_path"
}

show_available_levels()
{
    printf 'Available levels: level00'
    for flag_path in "$REPO_ROOT"/level[0-9][0-9]/flag; do
        [ -f "$flag_path" ] || continue
        previous_level=${flag_path%/flag}
        previous_level=${previous_level##*/}
        previous_number=${previous_level#level}
        previous_number=$(printf '%s\n' "$previous_number" | sed 's/^0*//')
        [ -n "$previous_number" ] || previous_number=0
        next_number=$((previous_number + 1))
        [ "$next_number" -le 99 ] || continue
        printf ' level%02d' "$next_number"
    done
    printf '\n'
}

choose_ssh_level()
{
    requested_level=${1:-}
    if [ -z "$requested_level" ] && [ -t 0 ]; then
        show_available_levels >&2
        printf 'Level [%s]: ' "$SSH_USER" >&2
        IFS= read -r requested_level || true
    fi
    [ -n "$requested_level" ] || requested_level=$SSH_USER

    SELECTED_SSH_USER=$(normalise_level "$requested_level") || \
        die "invalid level: $requested_level (expected 00, 01, level02, ...)"
    SELECTED_SSH_PASSWORD=$(level_password "$SELECTED_SSH_USER")
}

cleanup_askpass()
{
    [ -z "${ASKPASS_DIR:-}" ] || rm -rf -- "$ASKPASS_DIR"
}

ssh_to_level()
{
    level_user=$1
    level_password_value=$2
    shift 2

    need setsid
    ASKPASS_DIR=$(mktemp -d "${TMPDIR:-/tmp}/rainfall-askpass.XXXXXX") || \
        die "could not create the temporary SSH credential helper"
    chmod 700 "$ASKPASS_DIR"
    printf '%s' "$level_password_value" > "$ASKPASS_DIR/password"
    chmod 600 "$ASKPASS_DIR/password"
    cat > "$ASKPASS_DIR/askpass" <<'EOF'
#!/bin/sh
cat "$RAINFALL_ASKPASS_FILE"
EOF
    chmod 700 "$ASKPASS_DIR/askpass"
    trap cleanup_askpass 0
    trap 'exit 130' HUP INT TERM

    printf 'Connecting as %s (credential loaded locally)\n' "$level_user"
    DISPLAY=${DISPLAY:-rainfall:0} \
    SSH_ASKPASS=$ASKPASS_DIR/askpass \
    SSH_ASKPASS_REQUIRE=force \
    RAINFALL_ASKPASS_FILE=$ASKPASS_DIR/password \
        setsid -w ssh -p "$HOST_PORT" "$level_user@$HOST_IP" "$@"
}

vm_exists()
{
    VBoxManage showvminfo "$VM_NAME" >/dev/null 2>&1
}

vm_state()
{
    VBoxManage showvminfo "$VM_NAME" --machinereadable 2>/dev/null |
        sed -n 's/^VMState="\([^"]*\)"/\1/p'
}

download_ova()
{
    download_path=${1:-$OVA_PATH}
    download_dir=$(dirname "$download_path")
    mkdir -p "$download_dir"

    if [ -s "$download_path" ]; then
        printf 'OVA already present: %s\n' "$download_path"
        return 0
    fi

    printf 'Downloading RainFall OVA to %s\n' "$download_path"
    if command -v curl >/dev/null 2>&1; then
        curl -L --fail --retry 5 -C - --progress-bar \
            -o "$download_path" "$OVA_URL"
    elif command -v wget >/dev/null 2>&1; then
        wget -c -O "$download_path" "$OVA_URL"
    else
        die "curl or wget is required to download the OVA"
    fi
}

import_vm()
{
    import_path=${1:-$OVA_PATH}

    if vm_exists; then
        printf 'VM already imported: %s\n' "$VM_NAME"
        return 0
    fi

    [ -s "$import_path" ] || die "OVA not found: $import_path (run: $(basename "$0") download)"
    printf 'Importing %s as %s\n' "$import_path" "$VM_NAME"
    mkdir -p "$VM_BASE"
    VBoxManage import "$import_path" --vsys 0 --vmname "$VM_NAME" \
        --basefolder "$VM_BASE"
}

has_ssh_forward()
{
    VBoxManage showvminfo "$VM_NAME" --machinereadable 2>/dev/null |
        grep -E "^Forwarding\([0-9]+\)=\"[^,]+,tcp,[^,]*,${HOST_PORT},[^,]*,${GUEST_PORT}\"" \
        >/dev/null 2>&1
}

configure_ssh_forward()
{
    vm_exists || die "VM not imported (run: $(basename "$0") setup)"

    if has_ssh_forward; then
        printf 'SSH forwarding already configured: %s:%s -> guest:%s\n' \
            "$HOST_IP" "$HOST_PORT" "$GUEST_PORT"
        return 0
    fi

    pf_rule="$PF_NAME,tcp,$HOST_IP,$HOST_PORT,,$GUEST_PORT"
    current_state=$(vm_state)
    case "$current_state" in
        running)
            VBoxManage controlvm "$VM_NAME" natpf1 "$pf_rule"
            ;;
        poweroff)
            VBoxManage modifyvm "$VM_NAME" --natpf1 "$pf_rule"
            ;;
        *)
            die "cannot configure networking while VM state is: $current_state"
            ;;
    esac
    printf 'SSH forwarding configured: %s:%s -> guest:%s\n' \
        "$HOST_IP" "$HOST_PORT" "$GUEST_PORT"
}

start_vm()
{
    vm_exists || die "VM not imported (run: $(basename "$0") setup)"
    current_state=$(vm_state)
    if [ "$current_state" = running ]; then
        printf 'VM %s is already running\n' "$VM_NAME"
        return 0
    fi
    [ "$current_state" = poweroff ] || die "VM cannot start from state: $current_state"
    configure_ssh_forward
    VBoxManage startvm "$VM_NAME" --type headless
}

stop_vm()
{
    vm_exists || die "VM not imported"
    current_state=$(vm_state)
    if [ "$current_state" = poweroff ]; then
        printf 'VM %s is already stopped\n' "$VM_NAME"
        return 0
    fi
    [ "$current_state" = running ] || die "VM cannot cleanly stop from state: $current_state"
    shared_is_mounted && unmount_shared
    VBoxManage controlvm "$VM_NAME" acpipowerbutton
    printf 'Clean shutdown requested for %s\n' "$VM_NAME"
}

wait_for_poweroff()
{
    wait_count=0
    while [ "$wait_count" -lt 60 ]; do
        [ "$(vm_state)" = poweroff ] && return 0
        wait_count=$((wait_count + 1))
        sleep 1
    done
    return 1
}

wait_for_ssh()
{
    if ! command -v nc >/dev/null 2>&1; then
        sleep 5
        return 0
    fi

    ssh_wait_count=0
    while [ "$ssh_wait_count" -lt 60 ]; do
        if nc -z -w 1 "$HOST_IP" "$HOST_PORT" >/dev/null 2>&1; then
            return 0
        fi
        ssh_wait_count=$((ssh_wait_count + 1))
        sleep 1
    done
    return 1
}

shared_is_mounted()
{
    mountpoint -q "$SHARED_MOUNT" 2>/dev/null
}

mount_shared()
{
    shared_is_mounted && {
        printf 'Shared directory already mounted: %s\n' "$SHARED_DIR"
        return 0
    }
    [ -x "$SSHFS_BIN" ] || die "sshfs not found: $SSHFS_BIN"
    mkdir -p "$SHARED_MOUNT"
    if [ -d "$SHARED_DIR" ] && [ ! -L "$SHARED_DIR" ]; then
        [ -z "$(ls -A "$SHARED_DIR")" ] || \
            die "shared directory must be empty before first mount: $SHARED_DIR"
        rmdir "$SHARED_DIR"
    fi
    if [ ! -L "$SHARED_DIR" ]; then
        ln -s "$SHARED_MOUNT" "$SHARED_DIR"
    fi
    "$SSHFS_BIN" -p "$HOST_PORT" \
        -o reconnect,ServerAliveInterval=15,ServerAliveCountMax=3 \
        -o StrictHostKeyChecking=accept-new,IdentityFile="$HOME/.ssh/id_rsa" \
        "$SSH_USER@$HOST_IP:shared" "$SHARED_MOUNT"
    printf 'Shared directory mounted: %s <-> %s@VM:~/shared\n' \
        "$SHARED_DIR" "$SSH_USER"
}

unmount_shared()
{
    if shared_is_mounted; then
        fusermount3 -u "$SHARED_MOUNT"
        printf 'Shared directory unmounted: %s\n' "$SHARED_DIR"
    else
        printf 'Shared directory is not mounted: %s\n' "$SHARED_DIR"
    fi
}

show_status()
{
    if ! vm_exists; then
        printf 'VM: not imported\n'
        printf 'OVA: %s\n' "$OVA_PATH"
        return 1
    fi

    current_state=$(vm_state)
    printf 'VM: %s\nState: %s\n' "$VM_NAME" "$current_state"
    printf 'SSH: %s@%s -p %s\n' "$SSH_USER" "$HOST_IP" "$HOST_PORT"
    if command -v nc >/dev/null 2>&1 && nc -z -w 1 "$HOST_IP" "$HOST_PORT" >/dev/null 2>&1; then
        printf 'SSH port: ready\n'
    else
        printf 'SSH port: unavailable\n'
    fi
    if shared_is_mounted; then
        printf 'Shared directory: mounted at %s\n' "$SHARED_DIR"
    else
        printf 'Shared directory: not mounted\n'
    fi
}

doctor()
{
    printf 'RainFall VM doctor\n'
    if command -v VBoxManage >/dev/null 2>&1; then
        printf '[ok] VirtualBox: %s\n' "$(VBoxManage --version)"
    else
        printf '[missing] VBoxManage\n'
    fi
    if command -v ssh >/dev/null 2>&1; then
        printf '[ok] SSH client\n'
    else
        printf '[missing] SSH client\n'
    fi
    if [ -s "$OVA_PATH" ]; then
        printf '[ok] OVA: %s\n' "$OVA_PATH"
    else
        printf '[missing] OVA: %s\n' "$OVA_PATH"
    fi
    if command -v VBoxManage >/dev/null 2>&1 && vm_exists; then
        printf '[ok] VM: %s (%s)\n' "$VM_NAME" "$(vm_state)"
        if has_ssh_forward; then
            printf '[ok] SSH forwarding on port %s\n' "$HOST_PORT"
        else
            printf '[missing] SSH forwarding on port %s\n' "$HOST_PORT"
        fi
    else
        printf '[missing] VM: %s\n' "$VM_NAME"
    fi
    if [ -x "$SSHFS_BIN" ]; then
        printf '[ok] SSHFS: %s\n' "$SSHFS_BIN"
    else
        printf '[missing] SSHFS: %s\n' "$SSHFS_BIN"
    fi
}

command_name=${1:-help}
[ "$#" -eq 0 ] || shift

case "$command_name" in
    help|-h|--help|doctor|download)
        ;;
    *)
        need VBoxManage
        ;;
esac

case "$command_name" in
    help|-h|--help)
        usage
        ;;
    doctor)
        doctor
        ;;
    download)
        download_ova "${1:-$OVA_PATH}"
        ;;
    import)
        import_vm "${1:-$OVA_PATH}"
        configure_ssh_forward
        ;;
    setup)
        setup_path=${1:-$OVA_PATH}
        [ -s "$setup_path" ] || download_ova "$setup_path"
        import_vm "$setup_path"
        configure_ssh_forward
        ;;
    start)
        start_vm
        wait_for_ssh || die "SSH did not become ready within 60 seconds"
        mount_shared
        ;;
    gui)
        vm_exists || die "VM not imported (run: $(basename "$0") setup)"
        if [ "$(vm_state)" = poweroff ]; then
            configure_ssh_forward
            VBoxManage startvm "$VM_NAME" --type gui
        elif command -v VirtualBox >/dev/null 2>&1; then
            VirtualBox --startvm "$VM_NAME" </dev/null >/dev/null 2>&1 &
        else
            die "VirtualBox GUI command not found"
        fi
        ;;
    stop)
        stop_vm
        ;;
    restart)
        stop_vm
        wait_for_poweroff || die "shutdown timed out; use poweroff --force if necessary"
        start_vm
        wait_for_ssh || die "SSH did not become ready within 60 seconds"
        mount_shared
        ;;
    poweroff)
        [ "${1:-}" = --force ] || die "poweroff is immediate; confirm with: poweroff --force"
        vm_exists || die "VM not imported"
        if [ "$(vm_state)" = poweroff ]; then
            printf 'VM %s is already stopped\n' "$VM_NAME"
        else
            shared_is_mounted && unmount_shared
            VBoxManage controlvm "$VM_NAME" poweroff
        fi
        ;;
    status)
        show_status
        ;;
    ssh)
        need ssh
        vm_exists || die "VM not imported (run: $(basename "$0") setup)"
        [ "$(vm_state)" = running ] || start_vm
        wait_for_ssh || die "SSH did not become ready within 60 seconds"
        requested_level=
        case "${1:-}" in
            --level)
                [ "$#" -ge 2 ] || die "--level requires a level number"
                requested_level=$2
                shift 2
                ;;
            level[0-9]*|[0-9]*)
                requested_level=$1
                shift
                ;;
        esac
        choose_ssh_level "$requested_level"
        ssh_to_level "$SELECTED_SSH_USER" "$SELECTED_SSH_PASSWORD" "$@"
        ;;
    mount)
        vm_exists || die "VM not imported (run: $(basename "$0") setup)"
        [ "$(vm_state)" = running ] || start_vm
        wait_for_ssh || die "SSH did not become ready within 60 seconds"
        mount_shared
        ;;
    umount|unmount)
        unmount_shared
        ;;
    snapshot)
        vm_exists || die "VM not imported"
        snapshot_name=${1:-"snapshot-$(date +%Y%m%d-%H%M%S)"}
        VBoxManage snapshot "$VM_NAME" take "$snapshot_name"
        ;;
    info)
        vm_exists || die "VM not imported"
        VBoxManage showvminfo "$VM_NAME"
        ;;
    *)
        usage >&2
        die "unknown command: $command_name"
        ;;
esac

